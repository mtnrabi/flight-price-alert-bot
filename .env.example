# Free key (BASIC plan, no card): https://rapidapi.com/mtnrabi/api/google-flights-live-api
RAPIDAPI_KEY=

# Telegram: create a bot with @BotFather, then send it any message and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional, instead of or as well as Telegram): Channel settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# One request per watch per check
CHECK_EVERY_HOURS=6
